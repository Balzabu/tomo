  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="false" android:theme="@style/AppTheme" android:supportsRtl="true" android:enableOnBackInvokedCallback="false" android:dataExtractionRules="@xml/tomo_data_extraction_rules" android:fullBackupContent="false">
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
